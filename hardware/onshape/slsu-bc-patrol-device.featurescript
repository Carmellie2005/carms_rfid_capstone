function makeBox(context is Context, id is Id, corner1 is Vector, corner2 is Vector, partName is string, partColor is Color)
{
    fCuboid(context, id, {
            "corner1" : corner1,
            "corner2" : corner2
    });
    paintBody(context, id, partName, partColor);
}

function makeCylinder(context is Context, id is Id, bottomCenter is Vector, topCenter is Vector, radius is ValueWithUnits, partName is string, partColor is Color)
{
    fCylinder(context, id, {
            "bottomCenter" : bottomCenter,
            "topCenter" : topCenter,
            "radius" : radius
    });
    paintBody(context, id, partName, partColor);
}

function makeFrontScrew(context is Context, id is Id, x is number, z is number, screwColor is Color, slotColor is Color)
{
    makeCylinder(context, id + "head", vector(x, -43.0, z) * millimeter, vector(x, -40.2, z) * millimeter, 4.1 * millimeter, "Front screw head", screwColor);
    makeBox(context, id + "slot_horizontal", vector(x - 2.4, -43.4, z - 0.35) * millimeter, vector(x + 2.4, -42.9, z + 0.35) * millimeter, "Screw slot horizontal", slotColor);
    makeBox(context, id + "slot_vertical", vector(x - 0.35, -43.4, z - 2.4) * millimeter, vector(x + 0.35, -42.9, z + 2.4) * millimeter, "Screw slot vertical", slotColor);
}

function makeBuzzerHole(context is Context, id is Id, yOffset is number, zOffset is number)
{
    makeCylinder(context, id, vector(67.7, yOffset, 128 + zOffset) * millimeter, vector(68.8, yOffset, 128 + zOffset) * millimeter, 1.2 * millimeter, "Buzzer hole", color(0, 0, 0));
}

function paintBody(context is Context, id is Id, partName is string, partColor is Color)
{
    setProperty(context, {
            "entities" : qCreatedBy(id, EntityType.BODY),
            "propertyType" : PropertyType.NAME,
            "value" : partName
    });
    setProperty(context, {
            "entities" : qCreatedBy(id, EntityType.BODY),
            "propertyType" : PropertyType.APPEARANCE,
            "value" : partColor
    });
}
