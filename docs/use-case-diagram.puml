@startuml
left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #0F172A
}
skinparam rectangle {
  BorderColor #CBD5E1
  FontColor #0F172A
}

actor "Supervisor" as Supervisor
actor "Security Guard" as Guard

rectangle "SLSU Bontoc Patrol System" {
  usecase "Log In" as UC_Login
  usecase "Manage Profile Settings" as UC_Profile
  usecase "View Notifications" as UC_Notifications
  usecase "Mark Notifications\nas Read" as UC_ReadNotifications

  usecase "Scan Checkpoint" as UC_ScanCheckpoint
  usecase "Scan RFID Card" as UC_ScanRfid
  usecase "Take Area Selfie\nwith GPS Stamp" as UC_AreaSelfie
  usecase "Complete Patrol Checklist" as UC_Checklist
  usecase "Attach Checklist\nProof Photos" as UC_ProofPhotos
  usecase "Submit Patrol Record" as UC_SubmitPatrol
  usecase "Submit Incident Report" as UC_SubmitIncident
  usecase "View My Patrol Logs" as UC_MyPatrolLogs
  usecase "Download Own Patrol\nor Incident PDF" as UC_GuardPdf

  usecase "View Dashboard" as UC_Dashboard
  usecase "Manage Guard Profiles" as UC_ManageGuards
  usecase "Add Guard" as UC_AddGuard
  usecase "Edit Guard" as UC_EditGuard
  usecase "Delete Guard" as UC_DeleteGuard
  usecase "View Guard Records" as UC_GuardRecords

  usecase "Manage Checkpoints" as UC_ManageCheckpoints
  usecase "Add Checkpoint" as UC_AddCheckpoint
  usecase "Edit Checkpoint" as UC_EditCheckpoint
  usecase "Delete Checkpoint" as UC_DeleteCheckpoint

  usecase "Monitor Patrol Logs" as UC_PatrolLogs
  usecase "View Patrol Details,\nChecklist, and Photos" as UC_PatrolDetails
  usecase "Review Scan Issues" as UC_ScanIssues
  usecase "Review Incident Reports" as UC_IncidentReports
  usecase "Update Incident Status" as UC_UpdateIncident
  usecase "Generate Reports" as UC_Reports
  usecase "Filter Report Date Range" as UC_DateFilter
  usecase "Download or Print PDF" as UC_Pdf
  usecase "View Audit Trail" as UC_AuditTrail
  usecase "Enable Phone Alerts" as UC_PhoneAlerts
}

Supervisor --> UC_Login
Supervisor --> UC_Profile
Supervisor --> UC_Notifications
Supervisor --> UC_Dashboard
Supervisor --> UC_ManageGuards
Supervisor --> UC_ManageCheckpoints
Supervisor --> UC_PatrolLogs
Supervisor --> UC_ScanIssues
Supervisor --> UC_IncidentReports
Supervisor --> UC_Reports
Supervisor --> UC_AuditTrail
Supervisor --> UC_PhoneAlerts

Guard --> UC_Login
Guard --> UC_Profile
Guard --> UC_Notifications
Guard --> UC_ScanCheckpoint
Guard --> UC_MyPatrolLogs
Guard --> UC_GuardPdf

UC_Notifications ..> UC_ReadNotifications : <<include>>

UC_ScanCheckpoint ..> UC_ScanRfid : <<include>>
UC_ScanCheckpoint ..> UC_AreaSelfie : <<include>>
UC_ScanCheckpoint ..> UC_Checklist : <<include>>
UC_ScanCheckpoint ..> UC_SubmitPatrol : <<include>>
UC_ProofPhotos ..> UC_Checklist : <<extend>>
UC_SubmitIncident ..> UC_ScanCheckpoint : <<extend>>
UC_GuardPdf ..> UC_MyPatrolLogs : <<include>>

UC_ManageGuards ..> UC_AddGuard : <<include>>
UC_ManageGuards ..> UC_EditGuard : <<include>>
UC_ManageGuards ..> UC_DeleteGuard : <<include>>
UC_ManageGuards ..> UC_GuardRecords : <<include>>

UC_ManageCheckpoints ..> UC_AddCheckpoint : <<include>>
UC_ManageCheckpoints ..> UC_EditCheckpoint : <<include>>
UC_ManageCheckpoints ..> UC_DeleteCheckpoint : <<include>>

UC_PatrolLogs ..> UC_PatrolDetails : <<include>>
UC_IncidentReports ..> UC_UpdateIncident : <<include>>
UC_Reports ..> UC_DateFilter : <<include>>
UC_Reports ..> UC_Pdf : <<include>>
UC_PatrolLogs ..> UC_Pdf : <<extend>>
UC_IncidentReports ..> UC_Pdf : <<extend>>

@enduml
